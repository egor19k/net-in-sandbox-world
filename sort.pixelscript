static q=[]
static t=[]

def sort(inp) -> num:
    if inp==0:
        if len(q)==0:
            return 0
        best=0
        for i in range(len(t)):
            if t[i]>t[best]:
                best=i
        val=q[best]
        erase(q,best)
        erase(t,best)
        return val
    push(q,inp)
    push(t,0)
    for i in range(len(t)):
        t[i]+=1
    return 0